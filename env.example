# ============================================================
# StreamFlow Backend — Environment Variables
# Copy this file to .env and fill in the values.
# ============================================================

# ----------------------------------------------------------
# Database (required)
# ----------------------------------------------------------
DATABASE_URL=postgresql://streamflow_user:your_password@localhost/streamflow_music

# ----------------------------------------------------------
# Security (required)
# MUST be at least 32 random characters in production.
# Generate with: openssl rand -hex 32
# ----------------------------------------------------------
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# JWT token lifetime in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------
# CORS (required in production)
# Comma-separated list of allowed frontend origins.
# Use * (default) only in development.
# Production example: https://app.example.com,https://www.example.com
# ----------------------------------------------------------
CORS_ORIGINS=*

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------
# File uploads
# ----------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ALLOWED_EXTENSIONS=["mp3", "wav", "flac", "m4a"]

# ----------------------------------------------------------
# Logging
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
# ----------------------------------------------------------
LOG_LEVEL=INFO

# ----------------------------------------------------------
# Admin user (first-run setup via setup_production.py)
# If ADMIN_PASSWORD is not set, a secure random password is
# generated and printed once to stdout — save it immediately.
# ----------------------------------------------------------
# ADMIN_EMAIL=admin@streamflow.com
# ADMIN_PASSWORD=

# Set to "true" to also create a demo test user on first deploy.
# Not recommended for production.
# CREATE_TEST_USER=false

# ----------------------------------------------------------
# Optional: Redis (used for rate-limiting / caching)
# ----------------------------------------------------------
# REDIS_URL=redis://localhost:6379
