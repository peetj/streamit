# Database Configuration
DATABASE_URL=postgresql://streamflow_user:your_password@localhost/streamflow_music

# JWT Configuration
# REQUIRED — must be at least 32 characters. Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50000000
ALLOWED_EXTENSIONS=["mp3", "wav", "flac", "m4a"]

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Admin User (first-run setup)
# Optional — if not set, a random password is generated and printed once on first deploy
# ADMIN_EMAIL=admin@streamflow.com
# ADMIN_PASSWORD=

# Set to "true" to also create a demo test user on first deploy (not recommended for production)
# CREATE_TEST_USER=false

# CORS Configuration
# Comma-separated list of allowed frontend origins.
# Use "*" (default) for open access in development.
# In production set this to your frontend domain(s), e.g.: https://app.example.com
CORS_ORIGINS=*

# Optional: Redis Configuration (for caching)
# REDIS_URL=redis://localhost:6379

# Optional: AWS S3 Configuration (for file storage)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your_bucket_name

# Optional: Stripe Configuration (for payments)
# STRIPE_SECRET_KEY=your_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key 