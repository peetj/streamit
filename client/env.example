# ============================================================
# StreamFlow Frontend — Environment Variables
# Copy this file to .env.local (development) or pass as
# Docker build args for production.
# ============================================================

# ----------------------------------------------------------
# Backend API URL (required)
# In development this is proxied by Vite, so http://localhost:8000 works.
# In production Docker builds pass via: --build-arg VITE_BACKEND_URL=https://api.example.com
# ----------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8000

# ----------------------------------------------------------
# Image search APIs (optional)
# If neither key is set, built-in stock images are used as fallback.
#
# Unsplash (primary): https://unsplash.com/developers
#   Approval may take 5–10 days.
# Flickr (backup):    https://www.flickr.com/services/api/
#   Usually instant approval.
# ----------------------------------------------------------
VITE_UNSPLASH_ACCESS_KEY=
VITE_FLICKR_API_KEY=

# ----------------------------------------------------------
# Last.fm (optional — powers "Artist of the Day" feature)
# Register at: https://www.last.fm/api/account/create
# ----------------------------------------------------------
VITE_LASTFM_API_KEY=
VITE_LASTFM_SHARED_SECRET=
